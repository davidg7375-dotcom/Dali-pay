{
  "expo": {
    "name": "DALI PAY",
    "slug": "dali-pay",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#5b63ff",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5b63ff"
    },
    "android": {
      "package": "com.dalipay.app",
      "versionCode": 1,
      "supportsRtl": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "backgroundColor": "#5b63ff"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "extra": {},
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6D28D9",
          "defaultChannel": "dalipay"
        }
      ]
    ]
  }
}
