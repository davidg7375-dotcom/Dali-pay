{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "PUT_SUPABASE_URL_HERE",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "PUT_SUPABASE_ANON_KEY_HERE"
      }
    },
    "production": {
      "android": { "buildType": "apk" },
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "PUT_SUPABASE_URL_HERE",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "PUT_SUPABASE_ANON_KEY_HERE"
      }
    }
  }
}
